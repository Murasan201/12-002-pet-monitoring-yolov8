# ==============================================
# Slack通知設定
# ==============================================
# このファイルは環境変数のテンプレートです。
# 実際に使用する場合は、このファイルを .env にコピーして編集してください。
#
# コピー方法:
#   cp .env.example .env

# Bot User OAuth Token（Slack Appから取得）
# 形式: xoxb-で始まる文字列
# 取得方法: https://api.slack.com/apps から作成したAppの
#          「OAuth & Permissions」ページで確認
SLACK_BOT_TOKEN=your-slack-bot-token-here

# 通知先チャンネルID（Slackアプリから取得）
# 形式: Cで始まる11文字程度の英数字
# 取得方法: Slackでチャンネルを右クリック → 「チャンネル詳細を表示」
#          → 最下部の「チャンネルID」をコピー
SLACK_CHANNEL=C01XXXXXXXX

# Camera Configuration
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
# カメラ上下反転（true/false）
# Pan-Tiltブラケットのケーブル配線の都合上、カメラが逆さまになるためデフォルトでtrue
CAMERA_FLIP_VERTICAL=true

# YOLO Model (Hailo-8L HEF format)
# シンボリックリンク作成: ln -sf /usr/share/hailo-models/yolov8s_h8l.hef models/yolov8s_h8l.hef
YOLO_MODEL_PATH=models/yolov8s_h8l.hef
# 検出信頼度閾値（0.0-1.0）
# 低すぎると誤検出が増え、高すぎると検出漏れが増える
# 推奨値: 0.5（誤検出防止と検出率のバランス）
CONF_THRESHOLD=0.5

# Servo Control Parameters (P-control)
KP_PAN=0.02
KP_TILT=0.02
DEADBAND=10

# Scan Configuration
SCAN_STEPS_PAN=9
SCAN_STEPS_TILT=5

# Tracking Configuration
TRACKING_DURATION=8.0

# Image Capture Configuration
IMAGE_SAVE_DIR=./captured_images
CAPTURE_COUNT=3
IMAGE_LONG_EDGE=800
JPEG_QUALITY=70

# Schedule Configuration (minutes)
SCHEDULE_INTERVAL=10